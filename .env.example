# ─────────────────────────────────────────────────────────────
#  AI 제공자 — 둘 중 하나만 채우면 됩니다. 아무것도 없으면 오프라인 데모로 실행됩니다.
#  키를 넣은 뒤 `npm run check-ai` 로 실제 연결을 확인하세요.
# ─────────────────────────────────────────────────────────────

# Google Gemini — https://aistudio.google.com/apikey (무료 등급 있음)
GEMINI_API_KEY=

# Anthropic Claude — https://console.anthropic.com (선불 크레딧)
ANTHROPIC_API_KEY=

# 어느 쪽을 쓸지: auto | gemini | claude | offline
# auto 는 유효한 키를 찾아서 씁니다.
AI_PROVIDER=auto

# 모델 이름 (비워 두면 기본값)
#   Gemini: 이름이 자주 바뀝니다. `npm run list-models` 로 지금 쓸 수 있는 목록을 확인하세요.
#           기본값 gemini-3.5-flash-lite (빠르고 저렴)
#   Claude: claude-opus-5 (기본) / claude-sonnet-5 / claude-haiku-4-5
GEMINI_MODEL=gemini-3.5-flash-lite
CLAUDE_MODEL=claude-opus-5

# Gemini 생각(thinking): auto | off
# 최신 모델 상당수는 생각을 끌 수 없어서 off 를 거부합니다. 기본은 auto 로 두세요.
GEMINI_THINKING=auto

# Claude 이야기 생성 effort (low | medium | high) — 아이의 대기 시간과 직결됩니다
STORY_EFFORT=low

# ─────────────────────────────────────────────────────────────
#  앱 설정
# ─────────────────────────────────────────────────────────────

PORT=3000

# 부모 통제: 하루 놀이 시간(분)
DAILY_LIMIT_MINUTES=20

# 안전 계층 ③-b: 생성 내용 모델 재검사 (1=켜짐, 0=꺼짐)
# 켜면 더 안전하고, 끄면 한 턴이 1~2초 빨라지고 호출 수가 절반이 됩니다.
SAFETY_LLM_CHECK=1

# ─────────────────────────────────────────────────────────────
#  공개 배포용 (링크로 여러 사람이 들어올 때)
# ─────────────────────────────────────────────────────────────

# 1이면: 놀이 시간이 '모험별'로 걸리고, 부모 설정 변경이 잠깁니다.
PUBLIC_DEMO=0

# 남용 방지 상한
RPM_PER_IP=30
AI_CALLS_PER_HOUR=400

# 메모리에 남는 세션 정리
SESSION_TTL_MINUTES=120
MAX_SESSIONS=500
